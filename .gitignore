# Build output. frontend/dist is embedded by go:embed but is regenerated by
# `wails build`, so it is not tracked; build/bin holds the compiled binary.
build/bin
node_modules
frontend/dist

# Wails caches the dependency hash next to package.json.
frontend/package.json.md5

# Local session/agent metadata.
.freebuff/

# The chat database lives in ~/.config/kichat, but exclude any stray copy.
*.db
*.db-shm
*.db-wal

# Editor and OS noise.
.DS_Store
*.log
